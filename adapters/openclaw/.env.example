# ─────────────────────────────────────────────────────────────
# @firefly/adapter-openclaw — 环境变量示例
# 复制本文件为 .env 并填写实际值
# ─────────────────────────────────────────────────────────────

# Firefly 后端地址（不含末尾斜杠）
FIREFLY_BASE_URL=http://localhost:8000

# Firefly Ingest API Key（在 Firefly 控制台创建）
FIREFLY_API_KEY=replace-with-your-ingest-key

# Firefly 项目 ID（UUID，在控制台复制）
FIREFLY_PROJECT_ID=00000000-0000-0000-0000-000000000000

# 可选：开启 debug 日志（true/false）
FIREFLY_DEBUG=false
