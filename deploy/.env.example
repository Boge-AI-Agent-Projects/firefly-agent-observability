# ═══════════════════════════════════════════════════════════
# Firefly — .env 部署环境变量
#
# 复制到 deploy/.env 并修改密码和 API Key
# ═══════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_PASSWORD=replace-with-a-long-random-password
PG_PORT=5432

# ── Backend ────────────────────────────────────────────────
INGEST_API_KEY=replace-with-a-long-random-secret
APP_ENV=production
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Frontend ───────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_FIREFLY_API_URL=http://localhost:8000

# ── Network ────────────────────────────────────────────────
# 默认所有服务在 firefly-net 网络中互通
