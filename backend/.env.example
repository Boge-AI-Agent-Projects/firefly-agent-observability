# ─── Application ────────────────────────────────────────────────────────────
APP_NAME=firefly-backend
APP_ENV=development          # development | staging | production
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
# asyncpg driver for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://firefly:firefly@localhost:5432/firefly

# ─── OTLP / Observability ────────────────────────────────────────────────────
# Upstream OTLP endpoint (e.g. self-hosted Langfuse, Grafana Tempo)
OTLP_ENDPOINT=http://localhost:4318
OTLP_HEADERS=                # comma-separated key=value pairs (optional)

# ─── Security ────────────────────────────────────────────────────────────────
# Shared ingest secret — sent in X-Firefly-Key header by producers
INGEST_API_KEY=replace-with-a-long-random-secret

# ─── Pagination defaults ─────────────────────────────────────────────────────
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=200
